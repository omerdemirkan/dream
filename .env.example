# Copy to .env at the workspace root (alchemy reads it when run from here).
# Apex domain whose zone is already in the Cloudflare account.
DREAM_DOMAIN=omer.build
# Cloudflare credentials, unless an alchemy profile is configured (alchemy profile edit --add Cloudflare).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Who sees everyone's costs in the app (docs/metering.md): comma-separated emails. A plain var, so every deploy
# needs it; without it nobody gets the operator's view.
# DREAM_OPERATORS=
